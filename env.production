#*****************************************************************
# Production Environment Configuration for GenAI Stack
# Optimized for 3 VPS Docker Swarm Deployment
#*****************************************************************

#*****************************************************************
# LLM and Embedding Model
#*****************************************************************
LLM=llama2
EMBEDDING_MODEL=sentence_transformer

#*****************************************************************
# Neo4j Database Configuration
#*****************************************************************
NEO4J_URI=neo4j://database:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_secure_password_here

#*****************************************************************
# Ollama Configuration
#*****************************************************************
OLLAMA_BASE_URL=http://llm:11434

#*****************************************************************
# OpenAI (Optional - for enhanced performance)
#*****************************************************************
# Uncomment and configure if using OpenAI models
#OPENAI_API_KEY=sk-your-openai-key-here

#*****************************************************************
# AWS Configuration (Optional - for AWS Bedrock)
#*****************************************************************
# Uncomment and configure if using AWS services
#AWS_ACCESS_KEY_ID=your-aws-access-key
#AWS_SECRET_ACCESS_KEY=your-aws-secret-key
#AWS_DEFAULT_REGION=us-east-1

#*****************************************************************
# Google AI Configuration (Optional)
#*****************************************************************
# Uncomment and configure if using Google AI services
#GOOGLE_API_KEY=your-google-api-key

#*****************************************************************
# Langchain Configuration (Optional - for tracing)
#*****************************************************************
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
#LANGCHAIN_PROJECT=genai-stack-production
#LANGCHAIN_API_KEY=your-langchain-api-key

#*****************************************************************
# Monitoring Configuration
#*****************************************************************
GRAFANA_PASSWORD=your_secure_grafana_password

#*****************************************************************
# SSL Configuration
#*****************************************************************
# Set to your actual domain name for production
SSL_DOMAIN=your-domain.com

#*****************************************************************
# Performance Tuning
#*****************************************************************
# Neo4j memory settings (adjust based on your VPS specs)
NEO4J_MEMORY_HEAP_INITIAL_SIZE=512m
NEO4J_MEMORY_HEAP_MAX_SIZE=1G
NEO4J_MEMORY_PAGECACHE_SIZE=512m

# Docker swarm settings
DOCKER_SWARM_ADVERTISE_ADDR=your-manager-node-ip

#*****************************************************************
# Security Settings
#*****************************************************************
# Change these to secure values
JWT_SECRET=your-jwt-secret-key-here
API_KEY=your-api-key-here

#*****************************************************************
# Backup Configuration
#*****************************************************************
# S3 bucket for backups (optional)
#BACKUP_S3_BUCKET=your-backup-bucket
#BACKUP_S3_ACCESS_KEY=your-backup-access-key
#BACKUP_S3_SECRET_KEY=your-backup-secret-key
#BACKUP_S3_REGION=us-east-1